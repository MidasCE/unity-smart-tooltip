# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE project files
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Gradle / Plastic / Rider caches
.gradle/
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
.collabignore
*.private
*.private.meta
^*.private.[0-9]+$
^*.private.[0-9]+.meta$

# OS
.DS_Store
Thumbs.db

# Local link to the package samples, so they can be edited in this project.
# The real files live in Packages/com.pattarapol.smart-tooltip/Samples~
/[Aa]ssets/SmartTooltipSamples
/[Aa]ssets/SmartTooltipSamples.meta

# A global "*~" rule would hide this folder, but it must be in git.
!Samples~/
